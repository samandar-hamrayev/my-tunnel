# --- relay server (mytunnel server / docker compose) ---
# Comma-separated list of accepted client tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MYTUNNEL_TOKENS=change-me
# Optional: enable subdomain routing (<name>.tunnel.example.com). Needs wildcard DNS.
MYTUNNEL_DOMAIN=
# Optional: externally visible base URL shown to clients, e.g. https://tunnel.example.com
MYTUNNEL_PUBLIC_URL=
MYTUNNEL_REQUEST_TIMEOUT=30
MYTUNNEL_MAX_BODY_BYTES=10485760
MYTUNNEL_MAX_PENDING_PER_TUNNEL=100
MYTUNNEL_TRUSTED_PROXIES=127.0.0.1
MYTUNNEL_LOG_LEVEL=info
# Host port published by docker compose
MYTUNNEL_HOST_PORT=8080

# --- client (mytunnel http) ---
MYTUNNEL_SERVER=ws://127.0.0.1:8080
MYTUNNEL_TOKEN=change-me
